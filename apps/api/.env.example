# Copy to apps/api/.env (gitignored) and fill in. Addresses of the contract are NOT configured here:
# they come from contracts/deployments/fuji.json via @askpay/shared.
CHAIN_ID=43113
# The Avalanche public RPC (https://api.avax-test.network/ext/bc/C/rpc) can rate-limit by IP; see
# docs/runbook/setup-and-bringup.md §3. Use publicnode or an RPC with an API key for real runs.
RPC_URL=https://avalanche-fuji-c-chain-rpc.publicnode.com
# The key of the escrow's provider wallet. Never commit, never log.
PROVIDER_PRIVATE_KEY=
# The key that signs the checker's verdicts (A3). Must be a different key from the provider's: the
# escrow's `checker` address (contracts/deployments/fuji.json) is derived from it.
CHECKER_PRIVATE_KEY=
PRICE_UNITS=50000
QUOTE_TTL_SECONDS=300
DATABASE_PATH=./data/askpay.sqlite
PORT=4000
RATE_LIMIT_PER_MINUTE=20
# GET /questions, /stats, /corpus, /health, per IP. The page polls one question every second.
READ_RATE_LIMIT_PER_MINUTE=120
# Reverse proxies in front of the server (Render, Railway: 1). 0 locally. Wrong value = wrong IPs.
TRUST_PROXY_HOPS=0

# LLM for the answer step and the checker's judge (A2, A3). Required: without it every paid question
# would be refunded. Provider: openrouter or groq.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Set to false for a model that rejects response_format.
LLM_JSON_MODE=true

# Demo only (system-design §5.5): with true, a question that starts with "#demo-fake" gets a fake
# textHash on its first citation, so the chain refunds it as INVALID_CITATION. Keep false elsewhere.
DEMO_FAKE_CITATION=false
# Optional: another corpus file. Default: packages/corpus/data/blld-2019.khoan.json
# CORPUS_PATH=
# How many blocks one eth_getLogs may span on your RPC (the public Fuji RPC allows 100).
LOG_RANGE_BLOCKS=100
# With no checkpoint (a new or lost database): how many blocks back to look for stray deposits.
# About one block per 2 s, so 43200 is 24 hours. Older deposits: the payer claims after the deadline.
# The first run of the demo database sets this so the scan starts at block 61067095 (current block
# minus 61067095), after the 7 earliest test deposits whose question text is gone; reaching the
# deployment block (61046807) would count them again. /stats then lacks those 7 test transactions.
SCAN_LOOKBACK_BLOCKS=43200
