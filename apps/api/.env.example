# Copy to apps/api/.env (gitignored) and fill in. Addresses of the contract are NOT configured here:
# they come from contracts/deployments/fuji.json via @askpay/shared.
CHAIN_ID=43113
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# The key of the escrow's provider wallet. Never commit, never log.
PROVIDER_PRIVATE_KEY=
# The key that signs the checker's verdicts (A3). Must be a different key from the provider's: the
# escrow's `checker` address (contracts/deployments/fuji.json) is derived from it.
CHECKER_PRIVATE_KEY=
PRICE_UNITS=50000
QUOTE_TTL_SECONDS=300
DATABASE_PATH=./data/askpay.sqlite
PORT=4000
RATE_LIMIT_PER_MINUTE=20

# LLM for the answer step (A2). Set both or neither. Provider: openrouter or groq.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Set to false for a model that rejects response_format.
LLM_JSON_MODE=true

