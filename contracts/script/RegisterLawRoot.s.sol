pragma solidity 0.8.28;

import {Script, console2} from "forge-std/Script.sol";
import {AskPayEscrow} from "../src/AskPayEscrow.sol";

/// @notice Registers the Merkle root of BLLD 2019 on the deployed AskPayEscrow. The signer must be
/// the contract owner (`--account askpay-owner`). A lawId can be registered only once, so this
/// script checks everything it can before broadcasting.
///
/// Reads:
///   deployments/fuji.json                          escrow address (single source of truth)
///   ../packages/corpus/data/blld-2019.root.txt     the root, generated by `npm run corpus`
///   ../packages/corpus/data/blld-2019.foundry-vectors.json   lawLabel and lawId from the same build
contract RegisterLawRoot is Script {
    uint256 internal constant FUJI_CHAIN_ID = 43113;

    function run() external {
        require(block.chainid == FUJI_CHAIN_ID, "RegisterLawRoot: only Avalanche Fuji (43113)");

        address escrowAddr = vm.parseJsonAddress(vm.readFile("deployments/fuji.json"), ".address");
        AskPayEscrow escrow = AskPayEscrow(escrowAddr);

        bytes32 root = vm.parseBytes32(_trim(vm.readFile("../packages/corpus/data/blld-2019.root.txt")));
        string memory vectors = vm.readFile("../packages/corpus/data/blld-2019.foundry-vectors.json");
        bytes32 lawId = vm.parseJsonBytes32(vectors, ".lawId");

        // Cross-checks: the id must be keccak256 of the label, and both root sources must agree.
        require(lawId == keccak256(bytes(vm.parseJsonString(vectors, ".lawLabel"))), "lawId != keccak256(label)");
        require(root == vm.parseJsonBytes32(vectors, ".root"), "root.txt != vectors root");
        require(escrowAddr.code.length > 0, "no contract at deployments/fuji.json address");
        require(escrow.lawRoot(lawId) == bytes32(0), "lawId already registered");

        console2.log("escrow", escrowAddr);
        console2.log("owner", escrow.owner());
        console2.logBytes32(lawId);
        console2.logBytes32(root);

        vm.startBroadcast();
        escrow.setLawRoot(lawId, root);
        vm.stopBroadcast();

        require(escrow.lawRoot(lawId) == root, "lawRoot readback mismatch");
        console2.log("lawRoot registered and read back OK");
    }

    // root.txt ends with a newline.
    function _trim(string memory s) internal pure returns (string memory) {
        bytes memory b = bytes(s);
        uint256 n = b.length;
        while (n > 0 && (b[n - 1] == 0x0a || b[n - 1] == 0x0d || b[n - 1] == 0x20)) n--;
        bytes memory out = new bytes(n);
        for (uint256 i; i < n; i++) {
            out[i] = b[i];
        }
        return string(out);
    }
}
