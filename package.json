{
  "name": "askpay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --build && tsc -p packages/shared/tsconfig.test.json && tsc -p packages/corpus/tsconfig.test.json && tsc -p apps/api/tsconfig.test.json",
    "pretest": "tsc --build",
    "test": "vitest run",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run verify:contracts",
    "corpus": "tsc --build && node packages/corpus/dist/cli.js",
    "abi": "node scripts/gen-abi.mjs",
    "dev:api": "tsc --build && node --env-file=apps/api/.env apps/api/dist/server.js",
    "ask:client": "tsc --build && node --env-file=.env.e2e scripts/ask-client.mjs",
    "answer:live": "tsc --build && node --env-file=.env.poc scripts/answer-live.mjs",
    "check:live": "tsc --build && node --env-file=.env.poc scripts/check-live.mjs",
    "e2e:ask": "tsc --build && node --env-file=.env.poc --env-file=.env.e2e scripts/e2e-ask.mjs",
    "judge:injection": "tsc --build && node --env-file=.env.poc scripts/judge-injection.mjs",
    "e2e:contract": "tsc --build && node --env-file=.env.e2e scripts/e2e-contract-fuji.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
